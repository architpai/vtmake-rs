#!/usr/bin/env python3
"""Record comparison hashes, then run the system cmp without changes."""
import hashlib
import json
import os
from pathlib import Path
import sys
args = sys.argv[1:]
files = []
for s in args:
    p = Path(s)
    if p.is_file() or s == '/dev/null':
        files.append({'path': s, 'sha256': hashlib.sha256(p.read_bytes()).hexdigest()})
with (Path(os.environ['FELT_CASE']) / 'checks.jsonl').open('a') as f:
    f.write(json.dumps(files) + '\n')
os.execv('/usr/bin/cmp', ['cmp'] + args)
